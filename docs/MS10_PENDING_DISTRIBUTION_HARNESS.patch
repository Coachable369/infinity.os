+def trusted_peer(guest, peer):
+    state = guest.wait(lambda value: value[22] == 0, "current trust projection")
+    for index in range(min(state[24], 16)):
+        row = struct.pack("<16Q", *state[128+index*16:144+index*16])
+        if row[:32].hex() == peer:
+            return row[85] == 3
+    raise AssertionError({"missing_inspected_peer": peer})
+
