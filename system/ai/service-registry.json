{
  "schema": "infinityos.intelligence-service-registry",
  "version": 1,
  "mappingPath": "/system/ai/instruction-mappings.json",
  "authority": "Descriptive discovery only. Native typed targets and session permissions control execution. Edit aliases in mappingPath.",
  "settingsAudit": {
    "version": 1,
    "general": {
      "executable": [
        "os.setting.name",
        "os.clock.read",
        "os.clock.set",
        "os.clock.timeZone"
      ],
      "readOnly": [
        "language",
        "region",
        "system generation",
        "updates"
      ]
    },
    "appearance": {
      "executable": [
        "os.setting.theme",
        "os.setting.primary",
        "os.setting.accent",
        "os.setting.opacity",
        "os.setting.blur"
      ],
      "uiOnly": [
        "named icon family",
        "font selection",
        "wallpaper selection",
        "named worldshift selection"
      ]
    },
    "accounts": {
      "uiOnly": [
        "identity management",
        "credentials",
        "profile",
        "session management"
      ],
      "authorization": "Native identity confirmation required"
    },
    "aiVoice": {
      "executable": [
        "os.setting.speech"
      ],
      "uiOnly": [
        "provider policy",
        "desktop chat enabled",
        "named model selection",
        "microphone grant",
        "wake word"
      ]
    },
    "privacy": {
      "executable": [
        "os.setting.lockMinutes"
      ],
      "uiOnly": [
        "microphone grant"
      ],
      "readOnly": [
        "ambient authority",
        "remote AI",
        "trusted UI"
      ]
    },
    "devices": {
      "uiOnly": [
        "cursor selection"
      ],
      "readOnly": [
        "display",
        "keyboard",
        "audio input",
        "audio output"
      ]
    },
    "input": {
      "uiOnly": [
        "pointer speed",
        "scroll speed",
        "scroll direction",
        "primary button",
        "acceleration",
        "key repeat delay",
        "key repeat rate",
        "reset defaults"
      ]
    },
    "network": {
      "uiOnly": [
        "network mode",
        "interface enable",
        "DHCP",
        "IPv4 address",
        "prefix",
        "gateway",
        "metric",
        "DNS enable",
        "DNS servers",
        "remove default route",
        "activate profile",
        "default firewall policy"
      ],
      "authorization": "Native networking permissions and typed addresses required"
    },
    "nodesMesh": {
      "uiOnly": [
        "select node",
        "revoke trust",
        "block node",
        "open session",
        "begin pairing",
        "cancel pairing",
        "confirm pairing",
        "join",
        "leave",
        "category policy"
      ],
      "authorization": "Explicit NodeId and secure confirmation required"
    },
    "storage": {
      "uiOnly": [
        "select object",
        "select node",
        "placement",
        "replication policy"
      ],
      "authorization": "Explicit object and node IDs; verify asynchronous completion"
    },
    "about": {
      "readOnly": [
        "version",
        "architecture",
        "boot",
        "identity format",
        "icon families"
      ]
    }
  },
  "settingContracts": {
    "name": {
      "type": "string",
      "maxBytes": 48,
      "scope": "machine"
    },
    "theme": {
      "type": "string",
      "values": [
        "dark",
        "light",
        "color name",
        "#RRGGBB"
      ],
      "colorMeaning": "primary color, not a separately installed theme"
    },
    "primary": {
      "type": "RGB",
      "scope": "machine"
    },
    "accent": {
      "type": "RGB",
      "scope": "user"
    },
    "opacity": {
      "type": "integer",
      "min": 40,
      "max": 100,
      "step": 4
    },
    "blur": {
      "type": "integer",
      "min": 0,
      "max": 8
    },
    "lockMinutes": {
      "type": "integer",
      "min": 1,
      "max": 120
    },
    "speech": {
      "type": "enum",
      "values": [
        "on",
        "off"
      ]
    },
    "authorization": "Active owner session with settings-update capability; editing this document cannot change native permissions",
    "completion": "Persist authoritative settings and refresh live UI before reporting success"
  },
  "endpoints": [
