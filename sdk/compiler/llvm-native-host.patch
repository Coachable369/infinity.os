 void sys::unregisterHandlers() {
+#if defined(__INFINITY__)
+  sys::SmartScopedLock<true> Guard(*NativeRegistrationMutex);
+  if (NativeRegistered) {
+    if (infinity_compiler_unregister_crash_handler() != 0)
+      ReportErrnumFatal("Native context crash unregistration failed", errno);
+    NativeRegistered = false;
+  }
+#else
   // Restore all of the signal handlers to how they were before we showed up.
