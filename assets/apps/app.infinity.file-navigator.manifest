capability=Namespace.List
capability=Namespace.Create
capability=Namespace.Move
capability=Namespace.Attach
capability=Namespace.Detach
capability=Object.Read
capability=Object.Copy
capability=Object.MetadataRead
capability=Object.HistoryRead
capability=Trash.Use
capability=Application.Launch
